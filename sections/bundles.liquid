<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: 'Build your bundle' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'One box. Every room.' }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.lede | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign tier_prod = block.settings.product
            assign tier_idx = forloop.index
          -%}
          {%- if tier_prod != blank -%}
            {%- render 'product-card',
              card_product: tier_prod,
              card_type: 'tier',
              highlight: block.settings.highlight,
              tag_text: block.settings.tag_text,
              fine_text: block.settings.fine_text,
              cta_style: block.settings.cta_style,
              section_id: section.id
            -%}
          {%- else -%}
            {%- case tier_idx -%}
              {%- when 1 -%}
                <article class="glass tier rv" {{ block.shopify_attributes }}>
                  <span class="tag">{{ block.settings.tag_text | default: 'Starter' }}</span>
                  <div class="tierpix" aria-hidden="true"><span class="pimg p-combo2" role="img" aria-label="Purelane combo pack"></span></div>
                  <div class="qty">2<small>Products</small></div>
                  <div class="price">₹349 <s>₹598</s></div>
                  <p class="body-s" style="font-size:12px">{{ block.settings.fine_text | default: 'Flat ₹174 per product' }}</p>
                  <ul>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Pick any two products</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
                  </ul>
                  <a class="btn btn-ghost" href="#shop">Build this box</a>
                </article>
              {%- when 2 -%}
                <article class="glass tier best rv rv-d2" {{ block.shopify_attributes }}>
                  <span class="tag">{{ block.settings.tag_text | default: 'Most popular' }}</span>
                  <div class="tierpix" aria-hidden="true">
                    <span class="pimg p-kitchen" role="img" aria-label="Purelane kitchen cleaner"></span>
                    <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner"></span>
                    <span class="pimg p-dish" role="img" aria-label="Purelane dishwash gel"></span>
                  </div>
                  <div class="qty">3<small>Products</small></div>
                  <div class="price">₹499 <s>₹897</s></div>
                  <p class="body-s" style="font-size:12px">{{ block.settings.fine_text | default: 'Flat ₹166 per product' }}</p>
                  <ul>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Pick any three products</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Covers kitchen and laundry</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
                  </ul>
                  <a class="btn btn-primary" href="#shop">Build this box
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                  </a>
                </article>
              {%- else -%}
                <article class="glass tier rv rv-d3" {{ block.shopify_attributes }}>
                  <span class="tag">{{ block.settings.tag_text | default: 'Whole home' }}</span>
                  <div class="tierpix five" aria-hidden="true">
                    <span class="pimg p-kitchen" role="img" aria-label="Purelane kitchen cleaner"></span>
                    <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner"></span>
                    <span class="pimg p-floor" role="img" aria-label="Purelane floor cleaner"></span>
                    <span class="pimg p-toilet" role="img" aria-label="Purelane toilet cleaner"></span>
                    <span class="pimg p-laundry" role="img" aria-label="Purelane laundry detergent"></span>
                  </div>
                  <div class="qty">5<small>Products</small></div>
                  <div class="price">₹799 <s>₹1495</s></div>
                  <p class="body-s" style="font-size:12px">{{ block.settings.fine_text | default: 'Flat ₹160 per product' }}</p>
                  <ul>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Pick any five products</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Every room in one order</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
                  </ul>
                  <a class="btn btn-ghost" href="#shop">Build this box</a>
                </article>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <article class="glass tier rv">
          <span class="tag">Starter</span><div class="tierpix" aria-hidden="true"><span class="pimg p-combo2" role="img" aria-label="Purelane combo pack"></span></div>
          <div class="qty">2<small>Products</small></div>
          <div class="price">₹349 <s>₹598</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹174 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Pick any two products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>
        <article class="glass tier best rv rv-d2">
          <span class="tag">Most popular</span><div class="tierpix" aria-hidden="true"><span class="pimg p-kitchen" role="img" aria-label="Purelane kitchen cleaner"></span><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner"></span><span class="pimg p-dish" role="img" aria-label="Purelane dishwash gel"></span></div>
          <div class="qty">3<small>Products</small></div>
          <div class="price">₹499 <s>₹897</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹166 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Pick any three products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Covers kitchen and laundry</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-primary" href="#shop">Build this box
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </article>
        <article class="glass tier rv rv-d3">
          <span class="tag">Whole home</span><div class="tierpix five" aria-hidden="true"><span class="pimg p-kitchen" role="img" aria-label="Purelane kitchen cleaner"></span><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner"></span><span class="pimg p-floor" role="img" aria-label="Purelane floor cleaner"></span><span class="pimg p-toilet" role="img" aria-label="Purelane toilet cleaner"></span><span class="pimg p-laundry" role="img" aria-label="Purelane laundry detergent"></span></div>
          <div class="qty">5<small>Products</small></div>
          <div class="price">₹799 <s>₹1495</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹160 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Pick any five products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Every room in one order</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional)"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight as best value",
          "default": false
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag text",
          "default": "Most popular"
        },
        {
          "type": "text",
          "id": "fine_text",
          "label": "Price subtitle",
          "default": "Flat ₹166 per product"
        },
        {
          "type": "select",
          "id": "cta_style",
          "label": "Button style",
          "options": [
            { "value": "ghost", "label": "Ghost" },
            { "value": "primary", "label": "Primary" }
          ],
          "default": "ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag_text": "Starter", "highlight": false, "fine_text": "Flat ₹174 per product", "cta_style": "ghost" } },
        { "type": "tier", "settings": { "tag_text": "Most popular", "highlight": true, "fine_text": "Flat ₹166 per product", "cta_style": "primary" } },
        { "type": "tier", "settings": { "tag_text": "Whole home", "highlight": false, "fine_text": "Flat ₹160 per product", "cta_style": "ghost" } }
      ]
    }
  ]
}
{% endschema %}
