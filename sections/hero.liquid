{%- liquid
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
-%}

<section class="hero" id="top" data-scene="1">
  <div class="hero-grid">

    <div class="badges glass-2" aria-label="Product promises">
      {%- if badge_blocks.size > 0 -%}
        {%- for block in badge_blocks -%}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'ban' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- endcase -%}
            </span>
            {{ block.settings.text }}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="badge">
          <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
          Plant powered
        </div>
        <div class="badge">
          <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg></span>
          Kids &amp; pets
        </div>
        <div class="badge">
          <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg></span>
          Zero harsh chem
        </div>
      {%- endif -%}
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading | default: 'Clean' }}<br>
        <span class="lime">{{ section.settings.accent_heading | default: 'That Lasts' }}</span>
      </h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.lede | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.' }}</p>
      
      <div class="hero-cta rv rv-d3">
        <a class="btn btn-primary" href="{{ section.settings.button_1_link | default: '#shop' }}">
          {{ section.settings.button_1_label | default: 'Shop now' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="{{ section.settings.button_2_link | default: '#how' }}">
          {{ section.settings.button_2_label | default: 'How it works' }}
        </a>
      </div>

      <div class="badgestrip rv rv-d4">
        {%- if badge_blocks.size > 0 -%}
          {%- for block in badge_blocks -%}
            <div class="glass-2">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'ban' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- endcase -%}
              {{ block.settings.text | replace: '<br>', ' ' }}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="glass-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
            Plant powered
          </div>
          <div class="glass-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
            Kids &amp; pet safe
          </div>
          <div class="glass-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
            Zero harsh chem
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {%- if slide_blocks.size > 0 -%}
          {%- for block in slide_blocks -%}
            {%- assign slide_idx = forloop.index -%}
            <div class="hslide hs{{ slide_idx }}{% if forloop.first %} on{% endif %}" data-n="{{ slide_idx }}" {{ block.shopify_attributes }}>
              {%- case slide_idx -%}
                {%- when 1 -%}
                  <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
                {%- when 2 -%}
                  <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
                  <span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
                {%- else -%}
                  <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
                  <span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span>
                  <span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
              {%- endcase -%}
              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.price_label }}</span>
                <span class="val">
                  <strong>{{ block.settings.price }}</strong>
                  {%- if block.settings.compare_at_price != blank -%}<s>{{ block.settings.compare_at_price }}</s>{%- endif -%}
                </span>
                {%- if block.settings.discount_text != blank -%}<span class="cut">{{ block.settings.discount_text }}</span>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="hslide hs1 on" data-n="1">
            <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="glass-2 ptag"><span class="lbl">Single bottle</span><span class="val"><strong>₹200</strong><s>₹299</s></span><span class="cut">33% off</span></div>
          </div>
          <div class="hslide hs2" data-n="2">
            <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
            <span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="glass-2 ptag"><span class="lbl">Any 2 products</span><span class="val"><strong>₹349</strong><s>₹598</s></span><span class="cut">Save ₹249</span></div>
          </div>
          <div class="hslide hs3" data-n="3">
            <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
            <span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span>
            <span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="glass-2 ptag"><span class="lbl">Any 3 products</span><span class="val"><strong>₹499</strong><s>₹897</s></span><span class="cut">Save ₹398</span></div>
          </div>
        {%- endif -%}
      </div>
      <div class="hdots" id="hdots">
        {%- if slide_blocks.size > 0 -%}
          {%- for block in slide_blocks -%}
            <button type="button" class="{% if forloop.first %}on{% endif %}" aria-label="Show product group {{ forloop.index }}"></button>
          {%- endfor -%}
        {%- else -%}
          <button type="button" class="on" aria-label="Show 1 product"></button>
          <button type="button" class="" aria-label="Show 2 products"></button>
          <button type="button" class="" aria-label="Show 3 products"></button>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "accent_heading",
      "label": "Accent heading",
      "default": "That Lasts"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede text",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "ban", "label": "Ban" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹200"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at price",
          "default": "₹299"
        },
        {
          "type": "text",
          "id": "discount_text",
          "label": "Discount text",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "text": "Plant powered" } },
        { "type": "badge", "settings": { "icon": "shield", "text": "Kids & pets" } },
        { "type": "badge", "settings": { "icon": "ban", "text": "Zero harsh chem" } },
        { "type": "slide", "settings": { "price_label": "Single bottle", "price": "₹200", "compare_at_price": "₹299", "discount_text": "33% off" } },
        { "type": "slide", "settings": { "price_label": "Any 2 products", "price": "₹349", "compare_at_price": "₹598", "discount_text": "Save ₹249" } },
        { "type": "slide", "settings": { "price_label": "Any 3 products", "price": "₹499", "compare_at_price": "₹897", "discount_text": "Save ₹398" } }
      ]
    }
  ]
}
{% endschema %}
