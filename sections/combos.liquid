{% schema %}
{
  "name": "Combos",
  "tag": "section",
  "class": "section-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede text",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional)"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight as best value",
          "default": false
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Flag badge text",
          "default": "Most popular"
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings badge text",
          "default": "You save ₹398"
        },
        {
          "type": "select",
          "id": "cta_style",
          "label": "Button style",
          "options": [
            { "value": "ghost", "label": "Ghost" },
            { "value": "primary", "label": "Primary" }
          ],
          "default": "ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combos",
      "blocks": [
        { "type": "combo", "settings": { "flag_text": "Most popular", "savings_text": "You save ₹398", "cta_style": "ghost" } },
        { "type": "combo", "settings": { "flag_text": "", "savings_text": "You save ₹448", "cta_style": "ghost" } },
        { "type": "combo", "settings": { "highlight": true, "flag_text": "Best value", "savings_text": "Biggest saving", "cta_style": "primary" } },
        { "type": "combo", "settings": { "flag_text": "", "savings_text": "You save ₹398", "cta_style": "ghost" } },
        { "type": "combo", "settings": { "flag_text": "", "savings_text": "You save ₹249", "cta_style": "ghost" } }
      ]
    }
  ]
}
{% endschema %}
