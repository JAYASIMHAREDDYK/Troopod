<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Pre-built to save you money' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Best selling combos' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.lede | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' }}</p>
    </div>

    <div class="comborail-wrapper">
      <button class="rail-arrow rail-arrow--prev" type="button" aria-label="Previous combos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg>
      </button>

      <div class="comborail rv" role="region" aria-label="Best selling combos">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign combo_prod = block.settings.product
              assign combo_idx = forloop.index
            -%}
            {%- if combo_prod != blank -%}
              {%- render 'product-card',
                card_product: combo_prod,
                card_type: 'combo',
                highlight: block.settings.highlight,
                flag_text: block.settings.flag_text,
                savings_text: block.settings.savings_text,
                fine_text: block.settings.fine_text,
                cta_style: block.settings.cta_style,
                section_id: section.id
              -%}
            {%- else -%}
              {%- case combo_idx -%}
                {%- when 1 -%}
                  <article class="glass combo" {{ block.shopify_attributes }}>
                    <div class="tray">
                      <span class="save">{{ block.settings.savings_text | default: 'You save ₹398' }}</span>
                      <span class="flag">{{ block.settings.flag_text | default: 'Most popular' }}</span>
                      <div class="stack">
                        <span class="it"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span><span>Cuts grease instantly</span></span>
                        <span class="plus" aria-hidden="true">+</span>
                        <span class="it"><span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span><span>Squeaky clean dishes</span></span>
                        <span class="plus" aria-hidden="true">+</span>
                        <span class="it"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span>
                      </div>
                    </div>
                    <div class="body">
                      <h3>Kitchen essentials</h3>
                      <div class="cnt">3 products</div>
                      <p class="inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel &amp; Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately.</p>
                      <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
                      <div class="fine">Inclusive of all taxes &middot; COD available</div>
                      <a class="btn btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
                    </div>
