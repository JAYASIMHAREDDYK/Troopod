<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>4.8</b> {{ section.settings.rating_text | default: 'from 8,000+ reviews' }}</span>
      <span class="agg">{{ section.settings.secondary_stat | default: 'Loved by <b>12 lakh+</b> homes' }}</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- if section.blocks.size > 0 -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            <article class="glass-2 rcard" {{ block.shopify_attributes }}>
              <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <h5>{{ block.settings.heading }}</h5>
              <p>{{ block.settings.text }}</p>
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ block.settings.author }}</b>
                {%- if block.settings.product_label != blank -%}
                  <span>&middot; {{ block.settings.product_label }}</span>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..2) -%}
          <article class="glass-2 rcard">
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>Works like a charm</h5>
            <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>Anita</b><span>&middot; Laundry detergent</span>
            </div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>Best dishwash ever</h5>
            <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>Priya</b><span>&middot; Dishwash gel</span>
            </div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>Great product, great packaging</h5>
            <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>Sunita</b><span>&middot; Liquid handwash</span>
            </div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>Dog friendly</h5>
            <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>Rohit S.</b><span>&middot; Floor cleaner</span>
            </div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>Sparkling taps again</h5>
            <p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>Verified buyer</b><span>&middot; Tap cleaner</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "secondary_stat",
      "label": "Secondary stat text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Review heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review content",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "heading": "Works like a charm", "text": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "author": "Anita", "product_label": "Laundry detergent" } },
        { "type": "review", "settings": { "heading": "Best dishwash ever", "text": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "product_label": "Dishwash gel" } },
        { "type": "review", "settings": { "heading": "Great product, great packaging", "text": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "author": "Sunita", "product_label": "Liquid handwash" } },
        { "type": "review", "settings": { "heading": "Dog friendly", "text": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product_label": "Floor cleaner" } },
        { "type": "review", "settings": { "heading": "Sparkling taps again", "text": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "author": "Verified buyer", "product_label": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
