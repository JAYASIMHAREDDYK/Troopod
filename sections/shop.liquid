{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 8
  assign columns_desktop = section.settings.columns_desktop | default: 4
-%}

{%- style -%}
  .shop-section-{{ section.id }} {
    padding: var(--sec-y, 34px) 0;
  }
  .shop-section__wrap {
    max-width: var(--maxw, 1180px);
    margin: 0 auto;
    padding: 0 18px;
  }
  .shop-section__panel-head {
    text-align: center;
    margin-bottom: 26px;
  }
  .shop-section__kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(var(--pl-paper, 236, 230, 247), .52);
  }
  .shop-section__heading {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    line-height: .94;
    font-size: clamp(30px, 4.6vw, 54px);
    color: rgb(var(--pl-surface, 250, 247, 253));
    margin-top: 12px;
    margin-bottom: 12px;
  }
  .shop-section__rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 auto;
    max-width: 240px;
    justify-content: center;
  }
  .shop-section__rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, rgba(236,230,247,.44), transparent);
  }
  .shop-section__rule i:first-child {
    background: linear-gradient(90deg, transparent, rgba(236,230,247,.44));
  }
  .shop-section__rule svg {
    width: 16px;
    height: 16px;
    color: rgb(var(--pl-accent, 240, 160, 60));
    flex: 0 0 auto;
  }
  .shop-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 860px) {
    .shop-grid {
      grid-template-columns: repeat({{ columns_desktop }}, 1fr);
    }
  }
  .shop-empty-state {
    text-align: center;
    padding: 60px 20px;
    grid-column: 1 / -1;
    color: rgba(var(--pl-paper, 236, 230, 247), .74);
  }
  .card .shot {
    height: 150px;
    border-radius: 14px;
    margin-bottom: 14px;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(236,230,247,.12), rgba(75,58,143,.2));
    border: 1px solid rgba(236,230,247,.14);
  }
  .card .shot svg, .card .shot img {
    height: 122px;
    width: auto;
    object-fit: contain;
  }
  .card .pill {
    position: absolute;
    top: 9px;
    left: 9px;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(23,16,43,.6);
    border: 1px solid rgba(var(--pl-accent, 240, 160, 60), .32);
    color: rgb(var(--pl-accent, 240, 160, 60));
    z-index: 2;
  }
  .product-card__shot {
    height: 150px;
    border-radius: 14px;
    margin-bottom: 14px;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(236,230,247,.12), rgba(75,58,143,.2));
    border: 1px solid rgba(236,230,247,.14);
  }
  .product-card__img, .product-card__no-image {
    height: 122px;
    width: auto;
    object-fit: contain;
  }
  .product-card__pill {
    position: absolute;
    top: 9px;
    left: 9px;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(23,16,43,.6);
    border: 1px solid rgba(var(--pl-accent, 240, 160, 60), .32);
    color: rgb(var(--pl-accent, 240, 160, 60));
    z-index: 2;
  }
  .product-card__sold-out-badge {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(23, 16, 43, .72);
    backdrop-filter: blur(4px);
    z-index: 3;
  }
  .product-card__sold-out-badge span {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgb(var(--pl-surface, 250, 247, 253));
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(236, 230, 247, .2);
  }
  .product-card__title {
    font-family: 'Outfit', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: rgb(var(--pl-surface, 250, 247, 253));
    line-height: 1.2;
    margin-bottom: 7px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-card__rating {
    font-size: 11.5px;
    color: rgba(var(--pl-paper, 236, 230, 247), .74);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .product-card__rating b {
    color: rgb(var(--pl-accent, 240, 160, 60));
    font-weight: 700;
  }
{%- endstyle -%}

<section class="sec shop-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient" id="shop" data-section-id="{{ section.id }}">
  <div class="shop-section__wrap">
    <div class="shop-section__panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="shop-section__kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="shop-section__rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shop-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- render 'product-card', card_product: product, card_type: 'product', section_id: section.id -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {%- liquid
            capture placeholder_index
              cycle 1, 2, 3, 4, 5, 6
            endcapture
          -%}
          <article class="product-card product-card--product" aria-label="Product {{ i }}">
            <div class="product-card__shot">
              <span class="product-card__pill">Purelane</span>
              {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'product-card__no-image' }}
            </div>
            <div class="product-card__body">
              <h3 class="product-card__title">Plant-Based Cleaner {{ i }}</h3>
              <div class="product-card__rating"><b>&#9733; 4.8</b><span>&middot; 240 reviews</span></div>
              <div class="product-card__price-row">
                <strong>₹200</strong>
                <s>₹299</s>
                <em>33% off</em>
              </div>
              <div class="product-card__cta">
                <button type="button" class="btn btn-ghost btn-sm" aria-label="Add to cart">Add to cart</button>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop",
  "tag": "section",
  "class": "section-shop",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    }
  ],
  "presets": [
    {
      "name": "Shop"
    }
  ]
}
{% endschema %}
