{%- liquid
  assign sel_collection = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show | default: 8
-%}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Loved by 30,000 homes' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- if sel_collection != blank and sel_collection.products_count > 0 -%}
        {%- for product in sel_collection.products limit: product_limit -%}
          {%- liquid
            assign sold_out = false
            if product.available == false
              assign sold_out = true
            endif

            assign p_handle = product.handle
            assign pimg_class = 'p-tap'
            if p_handle contains 'kitchen'
              assign pimg_class = 'p-kitchen'
            elsif p_handle contains 'copper' or p_handle contains 'metal' or p_handle contains 'brass'
              assign pimg_class = 'p-metal'
            elsif p_handle contains 'washing' or p_handle contains 'descaler' or p_handle contains 'machine'
              assign pimg_class = 'p-wm'
            elsif p_handle contains 'dish'
              assign pimg_class = 'p-dish'
            elsif p_handle contains 'floor'
              assign pimg_class = 'p-floor'
            elsif p_handle contains 'toilet'
              assign pimg_class = 'p-toilet'
            elsif p_handle contains 'handwash'
              assign pimg_class = 'p-handwash'
            elsif p_handle contains 'laundry'
              assign pimg_class = 'p-laundry'
            elsif p_handle contains 'eraser'
              assign pimg_class = 'p-eraser'
            elsif p_handle contains 'kit' or p_handle contains 'combo'
              assign pimg_class = 'p-combo2'
            endif

            assign badge = product.metafields.purelane.badge.value | default: product.metafields.purelane.badge
            if badge == blank
              if forloop.index == 1 or forloop.index == 2
                assign badge = 'Best seller'
              elsif forloop.index == 3
                assign badge = 'Top rated'
              elsif forloop.index == 4
                assign badge = 'New'
              endif
            endif

            assign rating = product.metafields.purelane.rating.value | default: '4.8'
            assign reviews = product.metafields.purelane.review_count.value | default: 200
          -%}
          <article class="glass card rv{% if sold_out %} sold-out{% endif %}">
            <div class="shot">
              {%- if sold_out -%}
                <span class="pill" style="background:#e2daf3;border-color:rgba(75,58,143,.3);color:#241a3d">Sold out</span>
              {%- elsif badge != blank -%}
                <span class="pill">{{ badge }}</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" width="300" height="300" style="height:122px;width:auto;object-fit:contain">
              {%- else -%}
                <span class="pimg {{ pimg_class }}" role="img" aria-label="{{ product.title | escape }}"></span>
              {%- endif -%}
            </div>

            <h4 title="{{ product.title | escape }}" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em">{{ product.title }}</h4>
            <div class="rate"><b>★ {{ rating }}</b> · {{ reviews }} reviews</div>
            <div class="pr">
              <strong>{{ product.price | money_without_trailing_zeros }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- assign off_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <em>{{ off_pct }}% off</em>
              {%- endif -%}
            </div>

            {%- if sold_out -%}
              <button class="btn btn-ghost btn-sm" disabled aria-disabled="true" style="width:100%;justify-content:center;opacity:0.6;cursor:not-allowed">
                <span>Sold out</span>
              </button>
            {%- else -%}
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="btn btn-ghost btn-sm" type="submit" style="width:100%;justify-content:center">
                  <span>Add to cart</span>
                </button>
              {%- endform -%}
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        <article class="glass card rv">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover spray"></span></div>
          <h4>Tap cleaner &amp; limescale remover</h4>
          <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center">Add to cart</button>
        </article>
        <article class="glass card rv rv-d1">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner spray"></span></div>
          <h4>Kitchen cleaner, foaming</h4>
          <div class="rate"><b>★ 4.8</b> · 254 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center">Add to cart</button>
        </article>
        <article class="glass card rv rv-d2">
          <div class="shot"><span class="pill">Top rated</span><span class="pimg p-metal" role="img" aria-label="Copper, bronze and brass cleaner pump bottle"></span></div>
          <h4>Copper, bronze &amp; brass cleaner</h4>
          <div class="rate"><b>★ 4.8</b> · 231 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center">Add to cart</button>
        </article>
        <article class="glass card rv rv-d3">
          <div class="shot"><span class="pill">New</span><span class="pimg p-wm" role="img" aria-label="Washing machine cleaner and descaler tablets"></span></div>
          <h4>Washing machine cleaner &amp; descaler</h4>
          <div class="rate"><b>★ 4.8</b> · 183 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center">Add to cart</button>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Shelf",
  "tag": "section",
  "class": "section-shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Shop Shelf"
    }
  ]
}
{% endschema %}
