<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px" aria-label="Purelane home">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt"><span class="n1">Purelane</span><span class="n2">Clean, simply</span></span>
        </a>
        <p style="max-width:30ch">Effective cleaning, powered by nature. Made for Indian homes since day one.</p>
      </div>
      <div class="fcol">
        <h5>Shop</h5>
        <a href="{% if template.name == 'index' %}#shop{% else %}{{ routes.root_url }}#shop{% endif %}">Bestsellers</a>
        <a href="{% if template.name == 'index' %}#shop{% else %}{{ routes.root_url }}#shop{% endif %}">Kitchen</a>
        <a href="{% if template.name == 'index' %}#shop{% else %}{{ routes.root_url }}#shop{% endif %}">Laundry</a>
        <a href="{% if template.name == 'index' %}#shop{% else %}{{ routes.root_url }}#shop{% endif %}">Home</a>
        <a href="{% if template.name == 'index' %}#shop{% else %}{{ routes.root_url }}#shop{% endif %}">Skin</a>
        <a href="{% if template.name == 'index' %}#bundles{% else %}{{ routes.root_url }}#bundles{% endif %}">Starter kits</a>
      </div>
      <div class="fcol">
        <h5>About</h5>
        <a href="{% if template.name == 'index' %}#how{% else %}{{ routes.root_url }}#how{% endif %}">How it works</a>
        <a href="{% if template.name == 'index' %}#ingredients{% else %}{{ routes.root_url }}#ingredients{% endif %}">Sustainability</a>
        <a href="{% if template.name == 'index' %}#proof{% else %}{{ routes.root_url }}#proof{% endif %}">FAQs</a>
        <a href="{% if template.name == 'index' %}#voices{% else %}{{ routes.root_url }}#voices{% endif %}">Reviews</a>
      </div>
      <div class="fcol">
        <h5>Get in touch</h5>
        <a href="mailto:hello@purelane.com">hello@purelane.com</a>
        <a href="tel:+919930123234">+91 9930 123 234</a>
        <p style="font-size:12px;color:rgba(36,26,61,.56)">Purelane Eco Products Pvt Ltd</p>
      </div>
    </div>
    <div class="fbot">
      <span>&copy; {{ 'now' | date: '%Y' }} Purelane Eco Products Private Limited</span>
      <span>Privacy &middot; Terms &middot; Refunds &middot; Contact</span>
    </div>
  </div>
</footer>

